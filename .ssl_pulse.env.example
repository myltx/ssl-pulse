PORT="2026"
PYTHONUNBUFFERED="1"

# Dashboard auth
DASHBOARD_PASSWORD="change-me"
FLASK_SECRET_KEY="replace-with-random-long-string"
SESSION_TTL_MINUTES="720"

# Alert strategy
ALERT_DAYS="30"
ALERT_MILESTONES="30,15,7,3,1"
ENABLE_DAILY_REMINDER="true"

# Optional: bootstrap domains (comma-separated). Usually keep empty and manage via UI/domains.json
DOMAINS=""

# SMTP config (leave empty to disable email)
SMTP_SERVER=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
TO_EMAIL=""
